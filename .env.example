# Database — Neon Postgres pooled connection string
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"

# Better Auth
# BETTER_AUTH_URL: app base URL (http://localhost:3000 in dev, deploy URL in prod)
# BETTER_AUTH_SECRET: random secret — generate with `pnpm dlx @better-auth/cli secret`
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET="your-random-secret"

# Google Gemini (AI) — https://aistudio.google.com
GEMINI_API_KEY="your-gemini-api-key"

# Stripe (test mode) — https://dashboard.stripe.com
# STRIPE_SECRET_KEY: secret key (sk_test_... in test mode)
# STRIPE_PRICE_ID: recurring price id for the Pro plan (price_...)
# STRIPE_WEBHOOK_SECRET: signing secret from the webhook endpoint (whsec_...)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional — GitHub personal access token to raise the public API rate limit (60 -> 5000/hr)
# GITHUB_TOKEN="ghp_..."
